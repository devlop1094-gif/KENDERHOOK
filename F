local FREE_URL    = "https://raw.githubusercontent.com/devlop1094-gif/KENDERHOOK/refs/heads/main/kenderhook_free.lua"
local PREMIUM_URL = "https://raw.githubusercontent.com/devlop1094-gif/KENDERHOOK/refs/heads/main/kenderhook_premium.lua"
local KEYS_URL    = "https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/premium_keys.json"

local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local function httpGet(url)
    local ok, res = pcall(function()
        return game:HttpGet(url, true)
    end)
    if ok and type(res) == "string" and #res > 0 then
        return res
    end
    return nil
end

-- Load premium keys from remote JSON (fallback to local hardcodes if fetch fails)
local function loadPremiumKeys()
    local map = {}
    local raw = httpGet(KEYS_URL)
    if raw then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if ok and type(data) == "table" and type(data.keys) == "table" then
            for _, entry in ipairs(data.keys) do
                if type(entry) == "table" and type(entry.key) == "string" and entry.key ~= "" then
                    if entry.active ~= false then
                        -- optional expiry check (ISO date "YYYY-MM-DD" or null)
                        local expired = false
                        if type(entry.expires) == "string" and entry.expires ~= "" then
                            local y, m, d = entry.expires:match("^(%d+)%-(%d+)%-(%d+)$")
                            if y then
                                local exp = os.time({ year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 23, min = 59 })
                                if os.time() > exp then
                                    expired = true
                                end
                            end
                        end
                        if not expired then
                            map[entry.key] = true
                        end
                    end
                end
            end
        end
    end
    -- fallback hardcoded if json empty / fail
    if next(map) == nil then
        map["KENDER-PREMIUM-2026"] = true
        map["KH-PREM-RIVALS"] = true
        map["trial-premium"] = true
    end
    return map
end

local PREMIUM_KEYS = loadPremiumKeys()

local function isValidPremiumKey(key)
    if not key or key == "" then
        return false
    end
    return PREMIUM_KEYS[key] == true
end

local function loadScript(src, isPremium)
    if not src then
        warn("[KENDERHOOK] failed to fetch script")
        return
    end
    getgenv().KENDERHOOK_PREMIUM = isPremium and true or false
    getgenv().script_key = isPremium and (getgenv().script_key or "premium") or "free"
    local fn, err = loadstring(src)
    if not fn then
        warn("[KENDERHOOK] compile error:", err)
        return
    end
    local ok, rerr = pcall(fn)
    if not ok then
        warn("[KENDERHOOK] runtime error:", rerr)
    end
end

-- Auto-path if key already set in getgenv
local existing = tostring(getgenv().script_key or getgenv().Key or ""):gsub("%s+", "")
if existing ~= "" and isValidPremiumKey(existing) then
    local src = httpGet(PREMIUM_URL)
    loadScript(src, true)
    return
elseif existing == "free" then
    local src = httpGet(FREE_URL)
    loadScript(src, false)
    return
end

