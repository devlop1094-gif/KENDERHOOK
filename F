local loading = false

local function startLoad(isPremium)
    if loading then return end
    loading = true
    status.Text = isPremium and "loading premium..." or "loading free..."
    status.TextColor3 = Color3.fromRGB(180, 180, 100)

    task.spawn(function()
        local url = isPremium and PREMIUM_URL or FREE_URL
        local src = httpGet(url)
        if not src or #src < 100 then
            status.Text = "fetch failed - check github urls"
            status.TextColor3 = Color3.fromRGB(255, 80, 80)
            loading = false
            return
        end
        gui:Destroy()
        loadScript(src, isPremium)
    end)
end

